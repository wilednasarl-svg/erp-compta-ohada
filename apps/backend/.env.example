# ------------------------------------------------------------------
# ERP Compta — backend env template
# Copy to `.env` (never commit `.env`) and adjust values per environment.
# All variables are validated at boot by `src/config/env.validation.ts`.
# ------------------------------------------------------------------

# --- Application ---------------------------------------------------
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001

# --- Database (PostgreSQL / Supabase) ------------------------------
# Use the Supabase "Direct connection" URL in dev/test; the "Pooler"
# connection (port 6543) is recommended in prod for serverless callers.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_compta
# Set to `true` for Supabase (mandatory TLS); `false` for a local Postgres.
DB_SSL=false

# --- JWT -----------------------------------------------------------
# IMPORTANT: JWT_SECRET MUST be at least 32 characters.
# Generate one with:  openssl rand -hex 48
JWT_SECRET=replace-me-with-a-secret-of-at-least-32-characters
# Durée de validité d'un access token. Format: 15m, 1h, 900 (secondes brutes).
JWT_ACCESS_TTL=15m
# Durée de validité d'un refresh token. Format: 7d, 1w, 604800.
JWT_REFRESH_TTL=7d

# --- MFA -----------------------------------------------------------
# Base64-encoded key used to encrypt TOTP secrets at rest.
# MUST decode to exactly 32 bytes.
# Generate one with:  openssl rand -base64 32
MFA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- SMTP ----------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=postmaster@example.com
SMTP_PASS=change-me
SMTP_FROM=no-reply@example.com

# When true, outgoing emails are logged instead of sent (dev/test).
EMAIL_DRY_RUN=true

# --- Imports (Module 3) --------------------------------------------
# Root directory where uploaded source files (CSV / XLSX / Sage) are
# persisted before parsing. Resolved relative to the backend cwd.
IMPORT_STORAGE_DIR=./uploads
# Maximum size of a single uploaded file, in megabytes (1-500).
IMPORT_MAX_FILE_SIZE_MB=25

# --- Documents / GED (Module 10) -----------------------------------
# Storage driver: "local" (default, writes to DOC_STORAGE_DIR) or
# "supabase" (recommended for production — Railway containers are
# ephemeral and lose local files on restart).
DOC_STORAGE_DRIVER=local
DOC_STORAGE_DIR=./uploads/documents
DOC_MAX_FILE_SIZE_MB=50

# Supabase Storage — required when DOC_STORAGE_DRIVER=supabase.
# Use the SERVICE ROLE key (full admin access) — never the anon key.
# The bucket must be created manually in the Supabase dashboard
# and set to PRIVATE (all access flows through the backend API).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=documents
