# Copy to apps/backend/.env.test and fill TEST_DATABASE_URL with a
# dedicated test Postgres DSN. The e2e suite WILL drop and recreate
# the `public` schema on every run — never point this at dev or prod.
#
# Other variables fall back to safe test defaults set in
# test/setup/load-env.ts; only TEST_DATABASE_URL is mandatory.
#
# See docs/integration-tests.md for the full procedure.

TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/erp_compta_test

# Optional: set to `true` when targeting Supabase (which requires SSL).
# TEST_DB_SSL=true

# Optional: override the test secrets if your CI policy requires a real
# value rather than the deterministic fallbacks.
# JWT_SECRET=...
# MFA_ENCRYPTION_KEY=...
